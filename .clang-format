# Стиль курса: Google с отступом в четыре пробела, как в шаблонах лабораторных.
BasedOnStyle: Google
IndentWidth: 4
# Отличие от babysteps: короткие функции не схлопываем в одну строку,
# потому что слайды подсвечивают строки и однострочное тело прячет структуру.
AllowShortFunctionsOnASingleLine: None
